# Local preview: copy to .dev.vars (gitignored). Production secrets → Cloudflare dashboard / wrangler secret.
NEXTJS_ENV=development

# Mirror .env.local for `npm run cf:preview` (non-NEXT_PUBLIC_* only if used server-side)
# NEXT_PUBLIC_* can be set in wrangler.toml [vars] or dashboard for preview

# Scripture guide on comments (server → bible-ai). Local example:
# BIBLE_AI_BASE_URL=http://localhost:3040
# BIBLE_AI_API_KEY=your_shared_secret
# BIBLE_AI_HANDOFF_SECRET=long_random_shared_secret
# BIBLE_AI_PUBLIC_ORIGIN=http://localhost:3040
# BTW_BIBLE_AI_DAILY_LIMIT=30
# Bible Q&A nav uses /api/bible-ai/sso when BIBLE_AI_HANDOFF_SECRET is set (default)
# NEXT_PUBLIC_BIBLE_AI_SSO=false
# Legacy direct link (no SSO): NEXT_PUBLIC_BIBLE_AI_NAV=true

# Cloudflare R2 — channel media + profile avatars (copy to Worker Variables/Secrets in production)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Short videos (Cloudflare Stream). Token needs Stream:Edit. STREAM_ACCOUNT_ID falls back to R2_ACCOUNT_ID.
# Webhook: in Cloudflare run  POST /accounts/<id>/stream/webhook  with notificationUrl
#   https://believetheworks.org/api/shorts/webhook  and put the returned "secret" below.
# NEXT_PUBLIC_STREAM_CUSTOMER_CODE is the "customer-<code>" part of your Stream playback domain
# (set it at build time, it is public).
# STREAM_ACCOUNT_ID=
# STREAM_API_TOKEN=
# STREAM_WEBHOOK_SECRET=
# NEXT_PUBLIC_STREAM_CUSTOMER_CODE=

# Server-only Supabase service role key (required for post approval, comments and
# the Bible AI daily quota). Never prefix with NEXT_PUBLIC_. Production:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=
