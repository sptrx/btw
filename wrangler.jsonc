{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Plain-text Variables you set only in the Cloudflare dashboard are REMOVED on each
  // `wrangler deploy` unless you pass --keep-vars. Use `npm run cf:deploy` (Git/CLI) or
  // see docs/cloudflare-deploy.md → "Variables disappearing after a deploy".
  "name": "btw",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "btw"
    }
  ],
  // binding = code name (env.R2_MEDIA_BUCKET) — NOT a dashboard variable; do not create R2_MEDIA_BUCKET in Settings.
  // bucket_name = actual R2 bucket in Cloudflare — must equal the VALUE of your R2_BUCKET_NAME Worker variable.
  "r2_buckets": [
    {
      "binding": "R2_MEDIA_BUCKET",
      "bucket_name": "btw-bucket"
    }
  ]
}
